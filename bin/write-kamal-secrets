#!/usr/bin/env bash
# Rebuild .kamal/secrets for local Kamal deploys.
# CI regenerates this automatically; only needed if you're deploying from this machine.
# Run: bin/write-kamal-secrets
set -euo pipefail

SECRETS_FILE=".kamal/secrets"

# ── RAILS_MASTER_KEY ─────────────────────────────────────────────────────────
PRODUCTION_KEY_FILE="config/credentials/production.key"
if [[ -f "$PRODUCTION_KEY_FILE" ]]; then
  RAILS_MASTER_KEY=$(cat "$PRODUCTION_KEY_FILE")
  echo "✓ RAILS_MASTER_KEY read from $PRODUCTION_KEY_FILE"
else
  read -rsp "RAILS_MASTER_KEY (not found at $PRODUCTION_KEY_FILE): " RAILS_MASTER_KEY; echo
fi

# ── KAMAL_REGISTRY_PASSWORD ──────────────────────────────────────────────────
if command -v gh &>/dev/null && gh auth status &>/dev/null 2>&1; then
  KAMAL_REGISTRY_PASSWORD=$(gh auth token)
  echo "✓ KAMAL_REGISTRY_PASSWORD from gh CLI"
else
  read -rsp "KAMAL_REGISTRY_PASSWORD (GitHub PAT with packages:write): " KAMAL_REGISTRY_PASSWORD; echo
fi

# ── Prompted secrets ─────────────────────────────────────────────────────────
read -rsp "POSTGRES_PASSWORD: " POSTGRES_PASSWORD; echo
read -rsp "HETZNER_STORAGE_ACCESS_KEY_ID: " HETZNER_STORAGE_ACCESS_KEY_ID; echo
read -rsp "HETZNER_STORAGE_SECRET_ACCESS_KEY: " HETZNER_STORAGE_SECRET_ACCESS_KEY; echo
read -rp  "HETZNER_STORAGE_ENDPOINT (e.g. https://fsn1.your-objectstorage.com): " HETZNER_STORAGE_ENDPOINT
read -rp  "HETZNER_STORAGE_BUCKET [baashb]: " HETZNER_STORAGE_BUCKET
HETZNER_STORAGE_BUCKET="${HETZNER_STORAGE_BUCKET:-baashb}"

# ── Write ─────────────────────────────────────────────────────────────────────
printf '%s\n' \
  "RAILS_MASTER_KEY=$RAILS_MASTER_KEY" \
  "POSTGRES_PASSWORD=$POSTGRES_PASSWORD" \
  "BAASHB_DATABASE_PASSWORD=$POSTGRES_PASSWORD" \
  "HETZNER_STORAGE_ACCESS_KEY_ID=$HETZNER_STORAGE_ACCESS_KEY_ID" \
  "HETZNER_STORAGE_SECRET_ACCESS_KEY=$HETZNER_STORAGE_SECRET_ACCESS_KEY" \
  "HETZNER_STORAGE_ENDPOINT=$HETZNER_STORAGE_ENDPOINT" \
  "HETZNER_STORAGE_BUCKET=$HETZNER_STORAGE_BUCKET" \
  "KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD" \
  > "$SECRETS_FILE"

echo "✓ Wrote $SECRETS_FILE"
