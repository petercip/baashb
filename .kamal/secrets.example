# .kamal/secrets — copy this to .kamal/secrets and fill in real values.
# This file is gitignored. See bin/write-kamal-secrets for a helper script.
#
# CI regenerates .kamal/secrets automatically from GitHub Actions secrets/vars.
# For local deploys, run: bin/write-kamal-secrets

RAILS_MASTER_KEY=<contents of config/credentials/production.key>
POSTGRES_PASSWORD=<production postgres password>
BAASHB_DATABASE_PASSWORD=<same as POSTGRES_PASSWORD>
HETZNER_STORAGE_ACCESS_KEY_ID=<from Hetzner Console → Security → S3 Credentials>
HETZNER_STORAGE_SECRET_ACCESS_KEY=<from Hetzner Console → Security → S3 Credentials>
HETZNER_STORAGE_ENDPOINT=<e.g. https://fsn1.your-objectstorage.com>
HETZNER_STORAGE_BUCKET=baashb
KAMAL_REGISTRY_PASSWORD=<GitHub PAT with packages:read+write, or: gh auth token>
