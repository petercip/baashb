<% content_for :title, "#{@announcement.subject} — #{current_club.name}" %>

<div class="announcement-detail">
  <div class="announcement-detail__header">
    <p class="text-muted" style="margin-bottom: 0.25rem">
      <%= @announcement.sent_at.strftime("%B %-d, %Y") %>
      &middot;
      From <%= current_club.name %>
    </p>
    <h1><%= @announcement.subject %></h1>
  </div>

  <div class="announcement-detail__body">
    <%= simple_format @announcement.body %>
  </div>

  <p class="mt-4">
    <%= link_to "← All announcements", announcements_path, class: "text-muted" %>
  </p>
</div>
