<% content_for :title, "Announcements — #{current_club.name}" %>

<div class="page-heading">
  <h1>Announcements</h1>
</div>

<div class="announcement-list">
  <% if @announcements.empty? %>
    <p class="text-muted">No announcements yet.</p>
  <% else %>
    <% @announcements.each do |announcement| %>
      <div class="announcement-row">
        <div class="announcement-row__content">
          <a href="<%= announcement_path(announcement) %>" class="announcement-row__subject">
            <%= announcement.subject %>
          </a>
          <div class="announcement-row__meta text-muted">
            <%= announcement.sent_at.strftime("%B %-d, %Y") %>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
