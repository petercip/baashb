<!DOCTYPE html>
<html>
<body style="font-family: 'Inter', Arial, sans-serif; color: #1a1a1a; max-width: 560px; margin: 0 auto; padding: 32px 16px;">
  <p>Hi <%= @member.name.split.first %>,</p>

  <p>We received a request to reset your <%= @club.name %> password.</p>

  <p style="margin: 24px 0;">
    <a href="<%= @url %>"
       style="background:#c8a96e;color:#fff;padding:12px 24px;text-decoration:none;border-radius:4px;font-weight:600;display:inline-block;">
      Reset password
    </a>
  </p>

  <p style="color:#6b7280;font-size:0.875rem;">
    This link expires in 2&nbsp;hours. If you didn't request a reset, you can safely ignore this email — your password has not changed.
  </p>

  <p style="color:#6b7280;font-size:0.875rem;">
    Or copy and paste this URL into your browser:<br>
    <a href="<%= @url %>" style="color:#c8a96e;word-break:break-all;"><%= @url %></a>
  </p>

  <hr style="border:none;border-top:1px solid #e5e5e0;margin:32px 0;">
  <p style="color:#9ca3af;font-size:0.75rem;"><%= @club.name %></p>
</body>
</html>
