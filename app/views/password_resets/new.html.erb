<% content_for :title, "Reset password — #{current_club&.name}" %>

<div class="auth-page">
  <h1>Reset your password</h1>
  <p class="subtitle">
    Enter your email and we'll send a reset link. It expires in 2&nbsp;hours.
  </p>

  <%= form_with url: password_resets_path, method: :post do |f| %>
    <div class="form-group">
      <%= f.label :email, "Email address" %>
      <%= f.email_field :email,
            placeholder: "you@example.com",
            autofocus: true,
            autocomplete: "email",
            required: true %>
    </div>

    <div class="mt-4">
      <%= f.submit "Send reset link", class: "btn-primary", style: "width:100%" %>
    </div>
  <% end %>

  <p class="auth-page__footer-link">
    <%= link_to "Back to sign in", new_session_path %>
  </p>
</div>
