<%# Locals: member (required), f (form builder, required) %>

<% if member.errors.any? %>
  <div class="flash flash--alert" role="alert">
    <strong>Please fix the following:</strong>
    <ul>
      <% member.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="form-group">
  <%= f.label :name, "Full name" %>
  <%= f.text_field :name, placeholder: "Alice Chen", autofocus: true, required: true %>
</div>

<div class="form-group">
  <%= f.label :email, "Email address" %>
  <%= f.email_field :email, placeholder: "alice@example.com", required: true, autocomplete: "off" %>
</div>

<div class="form-group">
  <%= f.label :role, "Role" %>
  <%= f.select :role,
        [["Member", "member"], ["Organizer", "organizer"]],
        {},
        class: "form-select" %>
</div>

<div class="form-group">
  <%= f.label :bio, "Bio (optional)" %>
  <%= f.text_area :bio, rows: 4, placeholder: "A short intro that appears on their profile." %>
</div>
