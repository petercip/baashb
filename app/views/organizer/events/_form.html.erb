<%# Locals: event (required), f (form builder, required) %>

<% if event.errors.any? %>
  <div class="flash flash--alert" role="alert">
    <strong>Please fix the following:</strong>
    <ul>
      <% event.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="form-group">
  <%= f.label :name, "Event name" %>
  <%= f.text_field :name, placeholder: "Annual Dinner", autofocus: true, required: true %>
</div>

<div class="form-row">
  <div class="form-group">
    <%= f.label :starts_at, "Start date & time" %>
    <%= f.datetime_local_field :starts_at, required: true %>
  </div>
  <div class="form-group">
    <%= f.label :ends_at, "End time (optional)" %>
    <%= f.datetime_local_field :ends_at %>
  </div>
</div>

<div class="form-group">
  <%= f.label :venue, "Venue" %>
  <%= f.text_field :venue, placeholder: "The Boathouse, San Francisco", required: true %>
</div>

<div class="form-row">
  <div class="form-group">
    <%= f.label :capacity, "Capacity" %>
    <%= f.number_field :capacity, min: 1, required: true %>
  </div>
  <div class="form-group">
    <%= f.label :price_cents, "Ticket price ($ — 0 for free)" %>
    <%= f.number_field :price_cents, min: 0, step: "0.01",
          value: (f.object.price_cents / 100.0).round(2) %>
  </div>
</div>

<div class="form-group">
  <%= f.label :refund_cutoff_at, "Refund cutoff (optional)" %>
  <%= f.datetime_local_field :refund_cutoff_at %>
</div>

<div class="form-group">
  <%= f.label :description, "Description (optional)" %>
  <%= f.text_area :description, rows: 6, placeholder: "Join us for…" %>
</div>

<div class="form-group">
  <%= f.label :status, "Status" %>
  <%= f.select :status,
        [["Draft — not visible to members", "draft"],
         ["Published — visible to members", "published"],
         ["Cancelled", "cancelled"]],
        {},
        class: "form-select" %>
</div>
