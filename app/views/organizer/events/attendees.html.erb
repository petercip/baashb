<% content_for :title, "Attendees — #{@event.name}" %>

<div class="page-heading">
  <div>
    <h1>Attendees</h1>
    <p class="text-muted"><%= @event.name %> &middot; <%= @event.starts_at&.strftime("%B %-d, %Y") %></p>
  </div>
  <div class="page-heading__actions">
    <%= link_to "← Event", organizer_event_path(@event), class: "btn-ghost" %>
  </div>
</div>

<p>
  <strong><%= @rsvps.size %></strong> confirmed
  <% if @event.capacity %>
    of <strong><%= @event.capacity %></strong> capacity
    (<%= @event.spots_remaining %> spots remaining)
  <% end %>
</p>

<% if @rsvps.any? %>
  <table class="organizer-table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Email</th>
        <th>RSVP'd</th>
        <% unless @event.free? %>
          <th>Paid</th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% @rsvps.each do |rsvp| %>
        <tr>
          <td><%= link_to rsvp.member.name, organizer_member_path(rsvp.member) %></td>
          <td><%= rsvp.member.email %></td>
          <td><%= rsvp.created_at.strftime("%b %-d") %></td>
          <% unless @event.free? %>
            <td><%= rsvp.paid_at ? rsvp.paid_at.strftime("%b %-d") : "—" %></td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="text-muted">No confirmed attendees yet.</p>
<% end %>
