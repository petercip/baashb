<% content_for :title, "Edit #{@event.name} — Organizer" %>

<div class="page-heading">
  <h1>Edit Event</h1>
  <a href="<%= organizer_event_path(@event) %>" class="btn-ghost">← Back</a>
</div>

<div class="organizer-form-container">
  <%= form_with model: [:organizer, @event], class: "organizer-form" do |f| %>
    <%= render "form", event: @event, f: f %>
    <div class="form-actions">
      <%= f.submit "Save changes", class: "btn-primary" %>
      <%= link_to "Cancel", organizer_event_path(@event), class: "btn-ghost" %>
    </div>
  <% end %>
</div>
